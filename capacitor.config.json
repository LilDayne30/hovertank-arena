{
  "appId": "com.lildayne.hovertank",
  "appName": "Hover Tank Arena",
  "webDir": "dist-app",
  "backgroundColor": "#2b1d12",
  "loggingBehavior": "debug",
  "android": {
    "backgroundColor": "#2b1d12"
  },
  "ios": {
    "backgroundColor": "#2b1d12",
    "contentInset": "never",
    "scrollEnabled": false
  },
  "plugins": {
    "NativePurchases": {
      "autoFinishTransactions": false
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
