{
  "name": "hovertank",
  "version": "1.0.0",
  "description": "Lightweight 3D hover-tank arena for up to 4 players (PlayCanvas + Cloudflare Durable Objects)",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "test:bots": "node test/bots.mjs",
    "test:browser": "node test/browser4.cjs",
    "build:app": "vite build && node tools/prepare-app.mjs && npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "ios:upload": "bash tools/ios/upload.sh",
    "android:release": "npm run build:app && cd android && ./gradlew bundleRelease"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capgo/native-purchases": "8.9.5",
    "playcanvas": "2.23.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
